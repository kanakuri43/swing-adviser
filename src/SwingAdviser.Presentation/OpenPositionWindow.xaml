<mah:MetroWindow x:Class="SwingAdviser.Presentation.OpenPositionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="新規建て入力" Width="560" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="10" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4">
            <TextBlock TextWrapping="Wrap" Text="証券会社の約定通知を確認してから入力してください。現在値・終値・サイン日時からの自動確定はしません。" />
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="銘柄コード" />
            <TextBox Grid.Column="1" Padding="6,4" Text="{Binding StockCode, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="方向 / 信用取引" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="120" SelectedValue="{Binding DirectionText}" SelectedValuePath="Content">
                    <ComboBoxItem Content="Long" />
                    <ComboBoxItem Content="Short" />
                </ComboBox>
                <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" Content="信用取引" IsChecked="{Binding IsMargin}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定日時（JST）" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <mah:DateTimePicker Width="260"
                                    SelectedDateTime="{Binding ExecutedAtJst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Culture="ja-JP" HoursItemStringFormat="{}{0:00}" MinutesItemStringFormat="{}{0:00}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="JST (+09:00)" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定価格 / 株数" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="150" Padding="6,4" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="10,0" VerticalAlignment="Center" Text="/" />
                <TextBox Width="150" Padding="6,4" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="信用返済期限（任意）" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <DatePicker Width="150" SelectedDate="{Binding MarginDueDate}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="未入力の場合は「未確認」として扱われます。" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="メモ（任意）" />
            <TextBox Grid.Column="1" Padding="6,4" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="7" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding PreviewSummary}" />
            <TextBlock Margin="0,6,0,0" Foreground="#B00020" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0" Padding="12,5" Click="PreviewButtonClick" Content="プレビュー" />
            <Button x:Name="ConfirmButton" Margin="0,0,8,0" Padding="12,5" Click="ConfirmButtonClick" Content="確定して保存" IsEnabled="False" />
            <Button Padding="12,5" IsCancel="True" Content="キャンセル" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
